# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/executive-portal for a local mongod)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/executive-portal

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_TTL_MINUTES=30
# Optional separate salt for hashing IPs in consent records (defaults to JWT_SECRET)
IP_HASH_SALT=

# Frontend origin(s), comma-separated. Must match exactly (scheme + host + port).
CORS_ORIGIN=http://localhost:3000
# Leave empty unless you serve frontend and API from subdomains of one domain.
COOKIE_DOMAIN=

# Cloudinary (document storage). Without these, uploads return 503 STORAGE_UNAVAILABLE.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
